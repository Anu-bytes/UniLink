// Prisma schema for UniLink.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // Lets a query with relationLoadStrategy: "join" load its relations in one
  // SQL statement instead of one round trip per relation (the university
  // profile, see lib/catalog.ts). Other queries are unaffected.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// HEADS UP: free-text search depends on nine pg_trgm GIN indexes that live in
// raw SQL (see migrations/20260818120000_search_trgm_indexes) and cannot be
// expressed here. `prisma migrate dev` therefore reads them as drift and offers
// a migration that DROPs all nine. Applying that silently returns university,
// faculty and program search to sequential scans.
//
// If a generated migration contains "DROP INDEX ..._trgm_idx", delete it and
// re-run migrations/20260825090000_restore_search_trgm_indexes instead.

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models
// https://authjs.dev/getting-started/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id                  String                      @id @default(cuid())
  name                String?
  firstName           String? // collected at onboarding registration
  lastName            String?
  email               String                      @unique
  phone               String? // collected at onboarding registration
  emailVerified       DateTime?
  image               String?
  // Set only for email/password (credentials) accounts. OAuth users have none.
  passwordHash        String?
  role                UserRole                    @default(STUDENT)
  status              AccountStatus               @default(ACTIVE)
  statusReason        String?
  statusChangedAt     DateTime?
  lastLoginAt         DateTime?
  // When, and which version of, the Terms of Service and Privacy Policy the
  // user accepted (LEGAL_VERSION in src/lib/legal.ts). Null for accounts
  // created before acceptance was recorded.
  termsAcceptedAt     DateTime?
  termsVersion        String?
  accounts            Account[]
  sessions            Session[]
  studentProfile      StudentProfile?
  savedPrograms       SavedProgram[]
  savedFaculties      SavedFaculty[]
  savedUniversities   SavedUniversity[]
  universityRatings   UniversityRating[]
  passwordResetTokens PasswordResetToken[]
  // Bumped on every password change. Sessions minted before this instant are
  // rejected, so resetting a password logs out whoever else was signed in.
  passwordChangedAt   DateTime?
  applications        Application[]
  adminAssignments    UniversityAdminAssignment[] @relation("AssignedAdmin")
  assignmentsMade     UniversityAdminAssignment[] @relation("AssignedBy")
  changeRequests      ChangeRequest[]             @relation("ChangeAuthor")
  reviewedChanges     ChangeRequest[]             @relation("ChangeReviewer")
  auditLogs           AdminAuditLog[]
  searchLogs          SearchLog[]
  partnerRequests     PartnerRequest[]            @relation("PartnerRequestApplicant")
  reviewedRequests    PartnerRequest[]            @relation("PartnerRequestReviewer")
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
}

enum UserRole {
  STUDENT
  // A parent/guardian filling in the wizard on the applicant's behalf. Uses
  // the same StudentProfile shape as STUDENT; this only labels the account.
  PARENT
  PARTNER
  // Level 3: the super admin. Edits everything directly, reviews changes,
  // manages admin accounts. Kept as ADMIN so existing accounts keep access.
  ADMIN
  // Level 2: approves or rejects pending university edits and reads the
  // statistics. Cannot edit content directly.
  REVIEWER
  // Level 1: edits only the universities assigned to them, and every edit
  // waits in the review queue until a reviewer or super admin approves it.
  UNIVERSITY_ADMIN
}

// Whether an account may sign in. DISABLED is a pause (re-enable any time);
// BANNED is a block. Both end open sessions within a minute.
enum AccountStatus {
  ACTIVE
  DISABLED
  BANNED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// One in-flight password reset. Rows are short-lived: issuing a new code for
// an account deletes the account's previous rows, and a completed reset
// deletes them all.
//
// Nothing here is reversible into a credential. `codeHash` is a bcrypt hash of
// the six-digit code (bcrypt, not SHA, so that a leaked table cannot be
// brute-forced through a mere million candidates), and `ticketHash` is a
// SHA-256 hash of the opaque ticket handed out once the code checks out —
// 256 bits of entropy needs no slow hash.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  // Null until the code is verified; set when the reset ticket is issued.
  ticketHash String?
  expiresAt  DateTime
  // Wrong-code guesses against this row. The row dies at MAX_CODE_ATTEMPTS,
  // which is what stops a 10-minute window being walked through all 10^6 codes.
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

// Program-matching profile collected via the onboarding wizard. Created in the
// same transaction as the User at the final (account) step of the wizard.
model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  studyLevel            StudyLevel
  highSchoolSystem      HighSchoolSystem
  highSchoolSystemOther String? // free text when highSchoolSystem = OTHER
  graduationYear        Int // expected high-school graduation year
  gradeValue            String // expected grade, free text to fit any system
  fieldsOfStudy         String[]
  englishTest           EnglishTest      @default(NONE)
  englishScore          Float? // null when englishTest = NONE
  nationality           String // ISO 3166-1 alpha-2 country code
  intakeSeason          IntakeSeason
  intakeYear            Int
  budgetBand            BudgetBand // bucketed tuition budget in EGP
  // Short free-text "About Me" shown on the profile page. Purely
  // presentational — the match scorer in lib/matching.ts never reads it.
  bio                   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nationality])
}

enum StudyLevel {
  CERTIFICATE
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
}

// Secondary-education certificate a student holds. Mirrors HIGH_SCHOOL_SYSTEMS
// in src/lib/onboarding-schema.ts and doubles as the row key of the
// "Minimum Scores" tab on a university page.
enum HighSchoolSystem {
  THANAWEYA_AMMA
  IGCSE
  AMERICAN_DIPLOMA
  STEM
  AL_AZHAR
  ARAB_CERTIFICATE
  OTHER
}

enum EnglishTest {
  IELTS
  TOEFL
  PTE
  DUOLINGO
  NONE
}

enum IntakeSeason {
  WINTER
  SPRING
  SUMMER
  FALL
}

enum BudgetBand {
  UNDER_100K
  B100_200K
  B200_300K
  B300_500K
  OVER_500K
}

model University {
  id              String                      @id @default(cuid())
  name            String
  nameAr          String?
  // Short well-known abbreviation ("BUE", "GUC"), shown beside the full name.
  // Latin letters even on the Arabic site — that's how these are actually
  // written and recognised locally, not translated.
  acronym         String?
  slug            String                      @unique
  type            UniversityType
  country         String
  countryAr       String?
  city            String
  cityAr          String?
  description     String?
  descriptionAr   String?
  // Long-form body of the "About the University" tab. `description` stays the
  // short blurb used on cards and in the page hero.
  aboutRich       String?
  aboutRichAr     String?
  websiteUrl      String?
  logoUrl         String?
  coverImageUrl   String?
  establishedYear Int?
  addressLine     String?
  addressLineAr   String?
  phone           String?
  email           String?
  // Denormalised page-view counter shown in the hero meta row.
  viewCount       Int                         @default(0)
  isFeatured      Boolean                     @default(false)
  isRecommended   Boolean                     @default(false)
  isTrending      Boolean                     @default(false)
  publishedAt     DateTime?
  // Location as plain coordinates (simplified from the old PostGIS point).
  latitude        Float?
  longitude       Float?
  // A Google Maps link, for universities that have one on file but no
  // coordinates. Opened in a new tab rather than embedded (the site's CSP
  // only allows the OpenStreetMap iframe).
  googleMapsUrl   String?
  programs        Program[]
  faculties       Faculty[]
  scholarships    Scholarship[]
  images          UniversityImage[]
  features        UniversityFeature[]
  contentBlocks   UniversityContentBlock[]
  minimumScores   MinimumScore[]
  savedBy         SavedUniversity[]
  ratings         UniversityRating[]
  admins          UniversityAdminAssignment[]
  changeRequests  ChangeRequest[]
  viewDays        UniversityViewDaily[]
  searchLogs      SearchLog[]
  partnerRequests PartnerRequest[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([country])
  @@index([city])
  @@index([type])
  @@index([isFeatured, publishedAt])
}

// The two categories this catalog actually covers: Egypt's "national"
// (أهلية) universities — government-established but self-funded, distinct
// from free government/حكومية universities — and fully private (خاصة) ones.
// Free government universities aren't in scope for this platform, so there
// is deliberately no PUBLIC value here.
enum UniversityType {
  NATIONAL
  PRIVATE
}

// Gallery strip beside the university hero. The first image doubles as the
// large preview when `coverImageUrl` is not set.
model UniversityImage {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  url          String
  alt          String?
  altAr        String?
  sortOrder    Int        @default(0)

  @@index([universityId, sortOrder])
}

// Bullet points rendered under "Features of <university>" in the About tab.
model UniversityFeature {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title        String
  titleAr      String?
  body         String?
  bodyAr       String?
  sortOrder    Int        @default(0)

  @@index([universityId, sortOrder])
}

// Free-form prose for the tabs that are pure copy (admission requirements and
// criteria, tuition notes). Kept generic so the admin dashboard can add,
// reorder and translate blocks without a schema change.
model UniversityContentBlock {
  id           String         @id @default(cuid())
  universityId String
  university   University     @relation(fields: [universityId], references: [id], onDelete: Cascade)
  section      ContentSection
  title        String?
  titleAr      String?
  body         String
  bodyAr       String?
  sortOrder    Int            @default(0)

  @@index([universityId, section, sortOrder])
}

enum ContentSection {
  ADMISSION_REQUIREMENTS
  ADMISSION_CRITERIA
  TUITION_NOTES
  ABOUT_EXTRA
}

model Faculty {
  id            String         @id @default(cuid())
  universityId  String
  university    University     @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name          String
  nameAr        String?
  slug          String
  description   String?
  descriptionAr String?
  imageUrl      String?
  sortOrder     Int            @default(0)
  programs      Program[]
  minimumScores MinimumScore[]
  savedBy       SavedFaculty[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([universityId, slug])
  @@index([universityId, sortOrder])
}

// One row of the "Minimum Scores" tab: the cut-off for a given certificate
// system, either university-wide (facultyId null) or per faculty.
model MinimumScore {
  id           String           @id @default(cuid())
  universityId String
  university   University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  facultyId    String?
  faculty      Faculty?         @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  system       HighSchoolSystem
  minScore     Decimal          @db.Decimal(6, 2)
  unit         ScoreUnit        @default(PERCENT)
  year         Int?

  @@index([universityId])
  @@index([facultyId])
}

enum ScoreUnit {
  PERCENT
  GPA
  POINTS
}

model Program {
  id                   String                      @id @default(cuid())
  universityId         String
  university           University                  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  facultyId            String?
  faculty              Faculty?                    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  name                 String
  nameAr               String?
  slug                 String
  description          String?
  descriptionAr        String?
  studyLevel           StudyLevel
  fieldOfStudy         String
  durationMonths       Int?
  // Overrides the duration derived from `durationMonths` when a program needs
  // wording like "4 year bachelor's degree including an optional internship".
  durationLabel        String?
  durationLabelAr      String?
  tuitionFee           Decimal?                    @db.Decimal(12, 2)
  tuitionPeriod        TuitionPeriod               @default(YEAR)
  currency             String                      @default("EGP") @db.Char(3)
  applicationFee       Decimal?                    @db.Decimal(12, 2)
  applicationFeeWaived Boolean                     @default(false)
  // Minimum secondary-certificate percentage. Compared against the student's
  // onboarding grade by src/lib/matching.ts.
  minGradePercent      Float?
  coopAvailable        Boolean                     @default(false)
  tags                 ProgramTag[]
  intakes              ProgramIntake[]
  englishRequirements  ProgramEnglishRequirement[]
  savedBy              SavedProgram[]
  applications         Application[]
  isPublished          Boolean                     @default(false)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@unique([universityId, slug])
  @@index([universityId])
  @@index([facultyId])
  @@index([studyLevel])
  @@index([fieldOfStudy])
  @@index([isPublished])
}

enum TuitionPeriod {
  YEAR
  TERM
  TOTAL
}

// Perk pills on the program card, and the quick filters above the results.
enum ProgramTag {
  HIGH_JOB_DEMAND
  SCHOLARSHIPS_AVAILABLE
  FAST_ACCEPTANCE
  WAIVED_APPLICATION_FEE
  FINANCIAL_AID_AVAILABLE
  CREDIT_HOURS
}

model ProgramIntake {
  id                  String       @id @default(cuid())
  programId           String
  program             Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  season              IntakeSeason
  year                Int
  applicationDeadline DateTime?

  @@unique([programId, season, year])
  @@index([programId])
  @@index([year, season])
}

model ProgramEnglishRequirement {
  id        String      @id @default(cuid())
  programId String
  program   Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  test      EnglishTest
  minScore  Float

  @@unique([programId, test])
  @@index([programId])
}

// Kept for existing saved-program rows and the Application relation; the
// heart on a card now lives on the faculty, see SavedFaculty below.
model SavedProgram {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, programId])
  @@index([userId])
}

// The heart on a faculty card.
model SavedFaculty {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facultyId String
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, facultyId])
  @@index([userId])
}

// The heart on a university profile.
model SavedUniversity {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, universityId])
  @@index([userId])
}

// A signed-in student's 1 to 5 star rating of a university, shown on its
// profile. One per student per university; rating again replaces it. The
// 1..5 range is also enforced by a CHECK constraint in the migration.
model UniversityRating {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  stars        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, universityId])
  @@index([universityId])
}

// Which universities a UNIVERSITY_ADMIN may edit.
model UniversityAdminAssignment {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("AssignedAdmin", fields: [userId], references: [id], onDelete: Cascade)
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?      @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@unique([userId, universityId])
  @@index([universityId])
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ChangeAction {
  CREATE
  UPDATE
  DELETE
}

// A university admin's edit, held until a reviewer or super admin approves
// it. Keeps the original admin API call (method, path, body) so approving
// replays exactly the write the editor asked for, and the record as it was
// before, so the review screen can show a field-by-field diff.
model ChangeRequest {
  id           String              @id @default(cuid())
  universityId String
  university   University          @relation(fields: [universityId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?               @relation("ChangeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  entity       String
  entityId     String?
  entityLabel  String
  action       ChangeAction
  method       String
  path         String
  payload      Json?
  before       Json?
  status       ChangeRequestStatus @default(PENDING)
  reviewerId   String?
  reviewer     User?               @relation("ChangeReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?
  applyError   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([universityId, status])
  @@index([authorId, createdAt])
}

// Everything an admin did: direct edits, submitted and reviewed changes, and
// account management. Feeds each admin's recent-changes list.
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  entity       String
  entityId     String?
  entityLabel  String?
  universityId String?
  summary      String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([createdAt])
}

// Profile views per university per day, for trends. University.viewCount
// stays the all-time total.
model UniversityViewDaily {
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  day          DateTime   @db.Date
  views        Int        @default(0)

  @@id([universityId, day])
  @@index([day])
}

// One row per search a visitor ran (search page, quick search, homepage
// search). universityId is set when the search was for, or ended on, one
// university, which is what "most searched universities" counts.
model SearchLog {
  id           String      @id @default(cuid())
  query        String
  mode         String
  source       String
  locale       String?
  resultCount  Int?
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([createdAt])
  @@index([universityId, createdAt])
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId   String
  program     Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(DRAFT)
  submittedAt DateTime?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, programId])
  @@index([userId, status])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model Scholarship {
  id                  String      @id @default(cuid())
  universityId        String?
  university          University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  title               String
  titleAr             String?
  slug                String      @unique
  description         String?
  descriptionAr       String?
  fundingAmount       Decimal?    @db.Decimal(12, 2)
  currency            String      @default("EGP") @db.Char(3)
  applicationDeadline DateTime?
  isPublished         Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([universityId])
  @@index([applicationDeadline])
  @@index([isPublished])
}

model Testimonial {
  id          String   @id @default(cuid())
  studentName String
  quote       String
  quoteAr     String?
  location    String?
  locationAr  String?
  avatarUrl   String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

// Submissions from the public Partnership Request form (/contact). A lead
// inbox, nothing more: no status/workflow fields, no admin UI reads these
// yet. Whoever handles partnerships checks the table directly for now.
model PartnershipLead {
  id               String   @id @default(cuid())
  universityName   String
  city             String
  contactFirstName String
  contactLastName  String
  contactEmail     String
  contactTitle     String
  phone            String
  message          String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// Requests from the public "Work with us" page: a university booking a demo,
// or someone applying to represent their university on UniLink (approving
// one can grant them a university admin account). Everything here was typed
// by a stranger and is only ever rendered as text.
model PartnerRequest {
  id             String               @id @default(cuid())
  type           PartnerRequestType
  status         PartnerRequestStatus @default(NEW)
  fullName       String
  email          String
  phone          String
  jobTitle       String
  // The university picked from the catalogue, when it is one of ours.
  universityId   String?
  university     University?          @relation(fields: [universityId], references: [id], onDelete: SetNull)
  // As shown on the form: the catalogue name, or what they typed.
  universityName String
  city           String?
  // Demo only: the day and part of day they asked for, and how many attend.
  preferredDate  DateTime?            @db.Date
  preferredSlot  String?
  attendees      Int?
  // Representative only: a page proving the role (staff page, LinkedIn).
  proofUrl       String?
  message        String?
  locale         String               @default("en")
  // Set when the applicant was signed in.
  userId         String?
  user           User?                @relation("PartnerRequestApplicant", fields: [userId], references: [id], onDelete: SetNull)
  // Review.
  scheduledAt    DateTime?
  internalNote   String?
  reviewerId     String?
  reviewer       User?                @relation("PartnerRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  // The admin account an approved representative received.
  grantedUserId  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([type, status, createdAt])
  @@index([email, createdAt])
}

enum PartnerRequestType {
  DEMO
  REPRESENTATIVE
}

enum PartnerRequestStatus {
  NEW
  IN_REVIEW
  SCHEDULED
  APPROVED
  DECLINED
  CLOSED
}
