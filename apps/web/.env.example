# Supabase transaction pooler (port 6543) for application traffic.
# Copy the exact URI from Supabase Dashboard > Connect and keep the real
# password only in apps/web/.env.
#
# connection_limit / pool_timeout: the landing page runs several queries in
# parallel, so connection_limit=1 makes them queue and time out. A small pool
# (5) with a longer pool_timeout avoids that on a persistent server. If you
# deploy to a serverless platform with high concurrency, lower connection_limit
# back to 1–2 to avoid exhausting the Supabase pooler.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"

# Supabase session pooler (port 5432) for Prisma migrations and CLI commands.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"

# Auth.js
AUTH_SECRET="replace-with-a-random-secret"
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"
