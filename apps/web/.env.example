# Supabase transaction pooler (port 6543) for application traffic.
# Copy the exact URI from Supabase Dashboard > Connect and keep the real
# password only in apps/web/.env.
#
# connection_limit / pool_timeout.
#
# This is a pool per *instance*, not per deployment. On a long-running server a
# small pool (5) is right: the landing page fires several queries in parallel,
# so connection_limit=1 would make them queue.
#
# On Vercel it is the opposite. Every concurrent serverless instance opens its
# own pool, so connection_limit=N costs N x (live instances) connections
# against the Supabase pooler. A value like 20 exhausts the pooler under
# ordinary traffic, at which point requests fail outright rather than merely
# slowing down. Behind the transaction pooler (port 6543, pgbouncer=true) set
# connection_limit=1: pgbouncer is already doing the pooling, so Prisma should
# not pool on top of it.
#
# The value production actually uses comes from the environment variable in the
# Vercel project settings, not from this file.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"

# Supabase session pooler (port 5432) for Prisma migrations and CLI commands.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"

# Supabase Storage, used for profile picture uploads and for the catalogue
# images uploaded from the admin dashboard.
#
# SUPABASE_URL is the project URL from Supabase Dashboard > Project Settings >
# API. SUPABASE_SERVICE_ROLE_KEY is the service_role secret on the same page.
#
# The service-role key bypasses row level security. Keep it server-side only:
# never rename it to NEXT_PUBLIC_*, and never import lib/supabase-storage.ts
# from a "use client" file.
#
# Requires two storage buckets with public read access:
#
#   avatars  profile pictures (api/profile/avatar)
#   media    university logos, covers, gallery shots, faculty images and
#            testimonial portraits, uploaded from /admin (api/admin/media)
#
# Uploads go through the server, so neither bucket needs an insert policy for
# anonymous users. Leave these unset and both surfaces fall back to pasting an
# image URL by hand rather than failing.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-the-service-role-key"

# Auth.js
AUTH_SECRET="replace-with-a-random-secret"
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# Transactional email, used by the password-reset OTP flow.
#
# RESEND_API_KEY is an API key from https://resend.com/api-keys. EMAIL_FROM must
# be an address on a domain verified in that account, e.g.
# "UniLink <no-reply@unilink.example>".
#
# Leave both unset in development and the reset code is printed to the server
# console instead of being emailed, so the flow is testable without an email
# account. Production refuses to start a reset without them, rather than
# silently dropping the mail.
RESEND_API_KEY="replace-with-the-resend-api-key"
EMAIL_FROM="UniLink <no-reply@example.com>"
